<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
      <UserSecretsId>dc229f39-f9aa-4222-9d42-3a89984b483f</UserSecretsId>
  </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.14" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Abstractions" Version="10.0.14" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Analyzers" Version="10.0.14" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.14">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
        <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.14" />
        <PackageReference Include="System.Memory.Data" Version="10.0.14" />
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    </ItemGroup>

</Project>
